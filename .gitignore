# .gitignore root

# Maven / Java
**/target/
**/*.class
**/.mvn/wrapper/maven-wrapper.jar
**/*.log

# Node / Angular
**/node_modules/
**/.angular/
**/dist/
**/tmp/
**/.cache/

# IDE / OS
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.suo
*.user
*.userossc
*.sln.docstates

# Environment / Local
.env
.env.local
*.swp
