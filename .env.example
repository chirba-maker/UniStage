# =============================================================================
# UniStage — Variables d'environnement pour Docker & Production
# Copiez ce fichier vers .env et personnalisez les valeurs avant le déploiement.
# =============================================================================

# Base de données MySQL
MYSQL_DATABASE=unistage_db
MYSQL_USER=unistage_user
MYSQL_PASSWORD=unistage_password_sec
MYSQL_ROOT_PASSWORD=root_secure_password_2026

# Back-end Spring Boot
SERVER_PORT=8080
SPRING_JPA_HIBERNATE_DDL_AUTO=update
APP_FILE_STORAGE_DIR=/app/uploads

# Sécurité JWT (Clé secrète d'au moins 256 bits / 32 octets)
APP_JWT_SECRET=c2VjdXJlX3VuaXN0YWdlX2p3dF9zZWNyZXRfa2V5XzIwMjZfbGFiZV9ndWluZWVfcHJvZHVjdGlvbl8zMmJ5dGVz
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000

# Front-end Angular / Nginx
FRONTEND_PORT=80
